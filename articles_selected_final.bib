@article{han_null_2020a,
  title = {Null {{Objects}} in {{Korean}}: {{Experimental Evidence}} for the {{Argument Ellipsis Analysis}}},
  shorttitle = {Null {{Objects}} in {{Korean}}},
  author = {Han, Chung-hye and Kim, Kyeong-min and Moulton, Keir and Lidz, Jeffrey},
  year = {2020},
  journal = {Linguistic Inquiry},
  volume = {51},
  number = {2},
  pages = {319--340},
  publisher = {The MIT Press},
  issn = {1530-9150},
  urldate = {2026-06-26},
  abstract = {Null object (NO) constructions in Korean and Japanese have received different accounts: as (a) argument ellipsis (Oku 1998, S. Kim 1999, Saito 2007, Sakamoto 2015), (b) VP-ellipsis after verb raising (Otani and Whitman 1991, Funakoshi 2016), or (c) instances of base-generated pro (Park 1997, Hoji 1998, 2003). We report results from two experiments supporting the argument ellipsis analysis for Korean. Experiment 1 builds on K.-M. Kim and Han's (2016) finding of inter-speaker variation in whether the pronoun ku can be bound by a quantifier. Results showed that a speaker's acceptance of quantifier-bound ku positively correlates with acceptance of sloppy readings in NO sentences. We argue that an ellipsis account, in which the NO site contains internal structure hosting the pronoun, accounts for this correlation. Experiment 2, testing the recovery of adverbials in NO sentences, showed that only the object (not the adverb) can be recovered in the NO site, excluding the possibility of VP-ellipsis. Taken together, our findings suggest that NOs result from argument ellipsis in Korean.},
  keywords = {argument ellipsis,Korean,null object,null pronominal,sloppy reading},
  file = {C:\Users\grafmilj\Zotero\storage\SMSDHIN4\Han et al. - 2020 - Null Objects in Korean Experimental Evidence for the Argument Ellipsis Analysis.pdf}
}

@article{han_vraising_2007a,
  title = {V-{{Raising}} and {{Grammar Competition}} in {{Korean}}: {{Evidence}} from {{Negation}} and {{Quantifier Scope}}},
  shorttitle = {V-{{Raising}} and {{Grammar Competition}} in {{Korean}}},
  author = {Han, Chung-hye and Lidz, Jeffrey and Musolino, Julien},
  year = {2007},
  journal = {Linguistic Inquiry},
  volume = {38},
  number = {1},
  eprint = {4179396},
  eprinttype = {jstor},
  pages = {1--47},
  publisher = {The MIT Press},
  issn = {0024-3892},
  urldate = {2026-06-26},
  abstract = {In a head-final language, V-raising is hard to detect since there is no evidence from the string to support a raising analysis. If the language has a cliticlike negation that associates with the verb in syntax, then scope facts concerning negation and a quantified object NP could provide evidence regarding the height of the verb. Even so, such facts are rare, especially in the input to children, and so we might expect that not all speakers exposed to a head-final language acquire the same grammar as far as V-raising is concerned. Here, we present evidence supporting this expectation. Using experimental data concerning the scope of quantified NPs and negation in Korean, elicited from both adults and 4-year-old children, we show that there are two populations of Korean speakers: one with V-raising and one without.},
  file = {C:\Users\grafmilj\Zotero\storage\7KP5LSKN\Han et al. - 2007 - V-Raising and Grammar Competition in Korean Evidence from Negation and Quantifier Scope.pdf}
}

